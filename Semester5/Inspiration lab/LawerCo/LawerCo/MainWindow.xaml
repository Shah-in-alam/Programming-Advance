<Window x:Class="LawerCo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LawerCo"
        mc:Ignorable="d"
        Title="Sign Up" Height="450" Width="800">

    <!-- Define Styles for TextBox and PasswordBox -->
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer Margin="5" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Background="White">
                            <ScrollViewer Margin="5" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="YellowGreen">
        <Image Source="C:\Users\MOHAMMAD MIRAZ\OneDrive\Desktop\Semester5\Inspiration lab\LawerCo\LawerCo\Images\Logo (2).png" Width="100" Height="100"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="10"/>
        <Border Background="White" CornerRadius="15" Padding="25"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="320" Height="320">

            <StackPanel Width="250" VerticalAlignment="Center">

                <TextBlock Text="Username:" Foreground="Black" FontWeight="Bold"/>
                <TextBox x:Name="UsernameTextBox" Height="30" Margin="0,5,0,10"
                         BorderBrush="Gray" BorderThickness="1" Padding="5"/>

                <TextBlock Text="Email:" Foreground="Black" FontWeight="Bold"/>
                <TextBox x:Name="EmailTextBox" Height="30" Margin="0,5,0,10"
                         BorderBrush="Gray" BorderThickness="1" Padding="5"/>

                <TextBlock Text="Password:" Foreground="Black" FontWeight="Bold"/>
                <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,5,0,20"
                             BorderBrush="Gray" BorderThickness="1" Padding="5"/>

                <Button Content="Sign Up" Click="SignUpButton_Click"
                        Background="#1E90FF" Foreground="White" FontWeight="Bold"
                        Height="40" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1E90FF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#007ACC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                

            </StackPanel>
        </Border>
    </Grid>

</Window>


